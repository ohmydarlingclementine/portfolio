<script>
/* =====================================================================
   0. INTRO  (short black screen → curtain lifts → cover animates in)
   ✏️ INTRO_MS = how long the loading bar runs (1100 = 1.1 seconds). Use 600 for even shorter.
   ✏️ SHOW_ONLY_ONCE = true → plays once per visit session (recommended for recruiters)
   ===================================================================== */
(function () {
  const INTRO_MS = 1100;
  const SHOW_ONLY_ONCE = true;

  const intro = document.getElementById('intro');
  const bar = document.getElementById('inBar');
  const count = document.getElementById('inCount');
  const reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  let seen = false;
  try { seen = SHOW_ONLY_ONCE && sessionStorage.getItem('introSeen') === '1'; } catch (e) {}

  function finish() {
    if (finish.done) return; finish.done = true;
    document.body.classList.add('loaded');       // starts the cover animation
    intro.classList.add('out');                  // curtain lifts
    document.body.style.overflow = '';
    try { sessionStorage.setItem('introSeen', '1'); } catch (e) {}
    setTimeout(() => { intro.style.display = 'none'; }, 800);
  }

  if (seen || reduce) { intro.style.display = 'none'; document.body.classList.add('loaded'); return; }

  document.body.style.overflow = 'hidden';
  const t0 = performance.now();
  bar.style.transition = 'transform ' + INTRO_MS + 'ms linear';
  requestAnimationFrame(() => { bar.style.transform = 'scaleX(1)'; });
  (function tick(now) {
    const p = Math.min(1, (now - t0) / INTRO_MS);
    count.textContent = String(Math.round(p * 100)).padStart(2, '0');
    if (p < 1) requestAnimationFrame(tick);
  })(t0);
  setTimeout(finish, INTRO_MS + 150);
  intro.addEventListener('click', finish);       // click to skip
  document.addEventListener('keydown', finish, { once: true });
})();

/* =====================================================================
   1. CLOCK (Sweden time)
   ===================================================================== */
(function () {
  const el = document.getElementById('liveClock');
  function tick() {
    el.textContent = new Date().toLocaleTimeString('en-GB', { timeZone: 'Europe/Stockholm', hour12: false }) + ' CET';
  }
  tick(); setInterval(tick, 1000);
})();

/* =====================================================================
   2. SCROLL EFFECTS: top bar, progress line, cover fade
   ✏️ The cover fades while you scroll through the first 75% of the screen height.
      "40" = how far it floats up.
   ===================================================================== */
(function () {
  const nav = document.getElementById('nav');
  const progress = document.getElementById('progress');
  const heroWrap = document.querySelector('.hero .wrap');
  const contact = document.getElementById('contact');
  let ticking = false;
  function update() {
    const y = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    nav.classList.toggle('scrolled', y > 30);
    progress.style.transform = 'scaleX(' + (max > 0 ? y / max : 0) + ')';
    if (y < window.innerHeight * 1.3) {
      const p = Math.min(1, y / (window.innerHeight * 0.75));
      heroWrap.style.setProperty('--ho', 1 - p);
      heroWrap.style.setProperty('--hy', (-p * 40) + 'px');
    }
    document.body.classList.toggle('on-dark', contact.getBoundingClientRect().top < 50);
    ticking = false;
  }
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
})();

/* =====================================================================
   3. REVEAL ON SCROLL
   Big titles marked data-split get split into words that slide up.
   ===================================================================== */
(function () {
  document.querySelectorAll('[data-split]').forEach(el => {
    const text = el.textContent.trim();
    el.setAttribute('aria-label', text);
    el.innerHTML = text.split(/\s+/).map((w, i) => '<span class="w" aria-hidden="true"><span style="--k:' + i + '">' + w + '</span></span>').join(' ');
  });
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
  }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal,.shot,.ux-card,[data-split]').forEach(el => io.observe(el));
})();

/* =====================================================================
   4. FULL-SCREEN VIEWER
   Click a project: it grows from that picture to fill the screen (in full color).
   ← → keys, the buttons, or a swipe on phones go to the next one in the same segment.
   Esc, the Close button or a click on the picture closes it.
   Title + note come from data-title / data-note in the HTML.
   ===================================================================== */
(function () {
  const box = document.getElementById('lightbox');
  const media = document.getElementById('lbMedia');
  const title = document.getElementById('lbTitle');
  const note = document.getElementById('lbNote');
  const count = document.getElementById('lbCount');
  const prev = document.getElementById('lbPrev');
  const next = document.getElementById('lbNext');
  let list = [], idx = 0;

  function startClip(el) {                      // the little rectangle of the picture you clicked
    const r = (el.querySelector('.ph') || el).getBoundingClientRect();
    const t = Math.max(0, r.top), l = Math.max(0, r.left);
    const b = Math.max(0, window.innerHeight - r.bottom), rt = Math.max(0, window.innerWidth - r.right);
    return 'inset(' + t + 'px ' + rt + 'px ' + b + 'px ' + l + 'px)';
  }
  function show(i) {
    idx = (i + list.length) % list.length;
    const el = list[idx], img = el.querySelector('img');
    media.innerHTML = '';
    if (img && img.complete && img.naturalWidth) {
      const big = document.createElement('img'); big.src = img.currentSrc || img.src; big.alt = img.alt || '';
      media.appendChild(big);
    } else {
      const ph = document.createElement('div'); ph.className = 'lb-ph'; ph.textContent = el.dataset.ph || 'Add your image';
      media.appendChild(ph);
    }
    title.textContent = el.dataset.title || '';
    note.textContent = el.dataset.note || '';
    count.textContent = list.length > 1 ? '[ ' + (idx + 1) + ' / ' + list.length + ' ]' : '';
    prev.hidden = next.hidden = list.length < 2;
  }
  function open(el) {
    const g = el.closest('[data-group]');
    list = g ? [...g.querySelectorAll('[data-lightbox]')] : [el];
    show(list.indexOf(el));
    box.style.transition = 'none';
    box.style.clipPath = startClip(el);
    box.classList.add('open'); box.setAttribute('aria-hidden', 'false');
    void box.offsetWidth;
    box.style.transition = '';
    box.style.clipPath = 'inset(0px)';
    document.body.style.overflow = 'hidden';
    document.getElementById('lbClose').focus({ preventScroll: true });
  }
  function close() {
    box.style.clipPath = startClip(list[idx]);
    box.classList.remove('open'); box.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  document.addEventListener('click', e => {
    const el = e.target.closest('[data-lightbox]');
    if (el && !box.classList.contains('open')) { open(el); return; }
    if (!box.classList.contains('open')) return;
    if (e.target.closest('#lbClose') || e.target.closest('.lb-media')) close();
    else if (e.target.closest('#lbPrev')) show(idx - 1);
    else if (e.target.closest('#lbNext')) show(idx + 1);
  });
  document.addEventListener('keydown', e => {
    if (!box.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
  let sx = 0;                                    // swipe on phones
  box.addEventListener('touchstart', e => { sx = e.changedTouches[0].clientX; }, { passive: true });
  box.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50 && list.length > 1) show(idx + (dx < 0 ? 1 : -1));
  }, { passive: true });
})();

