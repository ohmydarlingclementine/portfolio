/* Name: changes font, stays one fixed size and width, so nothing moves. ✏️ edit font list */
(function(){
var F=[["'Archivo Black'",400],["'Pinyon Script'",400],["'Doto'",900],["'UnifrakturCook'",700],["'DM Mono'",500],["'Varela Round'",400]],T="Lina Orundas",n=document.getElementById('name'),i=0,S0=100,W=0;
var m=document.createElement('span');m.style.cssText='position:absolute;visibility:hidden;white-space:nowrap;font-size:100px;left:-9999px';m.textContent=T;document.body.appendChild(m);
function wid(f){m.style.fontFamily=f[0]+",serif";m.style.fontWeight=f[1];m.style.letterSpacing='0';return m.getBoundingClientRect().width}
/* every font is scaled so the name touches BOTH edges of the screen */
function fit(){W=n.parentElement.clientWidth-parseFloat(getComputedStyle(n.parentElement).paddingLeft)*2;var mx=0;F.forEach(function(f){mx=Math.max(mx,wid(f))});S0=100*W/mx;n.style.height=(S0*1.35)+'px';show(i)}
function show(k){var f=F[k%F.length],w100=wid(f),S=Math.min(100*W/w100,S0*1.35),w=w100*S/100,ls=(W-w)/(T.length-1);n.style.fontSize=S+'px';n.style.fontFamily=f[0]+",serif";n.style.fontWeight=f[1];n.style.letterSpacing=ls+'px'}
function start(){fit();if(!matchMedia('(prefers-reduced-motion:reduce)').matches)setInterval(function(){i++;show(i)},900);addEventListener('resize',fit)}
Promise.all(F.map(function(f){return document.fonts.load('100px '+f[0],T)})).then(start,start);
})();

(function(){
var p=document.getElementById('pile'),env=p.querySelector('.p-env'),rest=p.querySelectorAll('.paper:not(.p-env)');
function set(o){p.classList.toggle('open',o);env.setAttribute('aria-expanded',o?'true':'false');[].forEach.call(rest,function(x){if(o)x.removeAttribute('inert');else x.setAttribute('inert','')})}
set(false);
p.addEventListener('click',function(e){if(e.target.closest('a'))return;var o=p.classList.contains('open');set(!o);if(o){var r=p.getBoundingClientRect();if(r.top<0)window.scrollTo({top:window.scrollY+r.top-90,left:0,behavior:'smooth'})}});
function snapClose(){var h0=p.offsetHeight,above=p.getBoundingClientRect().bottom<0;p.classList.add('snap');set(false);var h1=p.offsetHeight;if(above)window.scrollBy({top:h1-h0,left:0,behavior:'instant'});requestAnimationFrame(function(){requestAnimationFrame(function(){p.classList.remove('snap')})})}
if('IntersectionObserver' in window)new IntersectionObserver(function(en){if(!en[0].isIntersecting&&p.classList.contains('open'))snapClose()},{threshold:0}).observe(p);
})();
</script>
